# Copy to .env and adjust if needed:  cp .env.example .env

# App
APP_NAME=melis
MELIS_CONTAINER_NAME=melis
MELIS_PLATFORM=local
# NOTE: the setup wizard rewrites this line. On the last step ("Finish") it applies
# the site module name entered at the modules step as MELIS_MODULE — here (so it
# survives a down/up) and in the running container (so the front site answers right
# away, no restart). See conf/melis-module-applier.sh.
MELIS_MODULE=MySite
TZ=Europe/Paris

# PHP version of the built image. 8.3 = default/recommended (officially supported).
# 8.4 = experimental but runs Melis. 8.5 is NOT usable yet (Laminas deps cap at 8.4
# → Melis composer install fails). Change → rebuild (--build).
PHP_VERSION=8.3

# Step-debugging: set to 1 to bake Xdebug into the image (IDE port 9003). Rebuild.
WITH_XDEBUG=0

# React back-office (/melis-react) — enabled by default in this repo. The first run
# composer-requires the public `melis-react` branches (melis-core + MelisReactApi +
# MelisReactOverride); set 0 for a plain legacy-only Melis. All three come from Packagist.
WITH_REACT=1

# Where an UN-INSTALLED platform sends every request (melis-installer's pre-install
# redirect guard). Empty/unset = the module's own default, /melis-react/setup — the
# React install wizard, served by MelisReactOverride's SPA route. Set it to
# /melis/setup to get the legacy wizard back. Only affects the pre-install redirect;
# both wizards stay reachable by URL either way, and the value is irrelevant once
# the platform is installed (you are then sent to /melis/login).
# NOT honoured by any released melis-installer yet — the stable 6.0.x on Packagist
# hardcodes /melis/setup and ignores this var (so you get the legacy wizard whatever
# you set here). It needs patches/melis-installer-react-setup-redirect.patch, which
# is what the dev-melis-react branch this repo tests against carries.
MELIS_SETUP_ROUTE=

# Melis skeleton version for `composer create-project`. Empty = latest stable.
# The 6.x line dropped the four laminas `vcs` repositories in favour of the
# Packagist-published melisplatform/laminas-* forks, which is what removes the GitHub
# API enumeration entirely — so no GitHub token is needed. Empty = latest stable.
# Pin to 5.3.x only if you need the old line; that one still declares those vcs repos
# and is slower / rate-limit-prone without a token.
# The React back-office modules are declared in the skeleton's own
# config/application.config.php since v6.0.6.
SKELETON_VERSION=^6.0

# Host user the container's Apache runs as, so the app tree stays editable on your
# host. The entrypoint chowns the app dir to www-data (the web installer runs as
# Apache and rewrites composer.json / vendor/ / config/); these remap www-data to
# your uid/gid, so the same files are writable by Apache AND by you.
# Defaults suit a single-user Linux/WSL box. If `id -u` says something else, set it:
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
# Set HOST_UID=33 for the classic www-data ownership (tree not host-writable).
# Changing these needs a rebuild (`docker compose up -d --build`).
HOST_UID=1000
HOST_GID=1000

# Ports (host side)
HOST_PORT=8080
DB_HOST_PORT=33061

# React dev server (Vite + HMR). This stack ALWAYS starts it — it is the stack for
# working on the React back-office. http://localhost:$VITE_PORT
# (Not needed to just USE /melis-react, which PHP serves from the committed build;
#  to skip it: `docker compose up -d php db`.)
VITE_PORT=5173
# Node image tag for that service.
NODE_VERSION=22

# Optional — only when running behind the shared local nginx-proxy
# (docker-compose.proxy.yml). Hostname this stack answers to; HOST_PORT is dropped.
# VIRTUAL_HOST=melis-install.local

# Database (these are the credentials to enter in the Melis web installer)
MYSQL_VERSION=8.4
MYSQL_DATABASE=melis
MYSQL_USER=melis
MYSQL_PASSWORD=melis

