# Copy to .env and adjust:  cp .env.example .env

APP_NAME=melis-dev

MELIS_PLATFORM=dev
MELIS_MODULE=MySiteTest
TZ=Europe/Paris

# PHP version of the built image. 8.3 = default/recommended (officially supported).
# 8.4 = experimental but runs Melis. 8.5 needs extra fixes (see CLAUDE.md).
# Change → rebuild (docker compose up --build).
PHP_VERSION=8.3

MELIS_CONTAINER_NAME=melis-dev
# Host ports. Every runnable stack in this repo defaults to the SAME pair (8080 /
# 33061) because they are alternatives — you normally run one at a time. To run two
# side by side, change these here (and keep MELIS_CONTAINER_NAME distinct, which it
# already is for this stack), or put both behind the shared proxy (../../local-proxy).
HOST_PORT=8080
# Host-side port for the database. The container side is always 3306 and is not
# configurable — set this to any free port on your machine, NOT to 3306's twin.
DB_HOST_PORT=33061
MYSQL_VERSION=8.4
MYSQL_HOST=db
MYSQL_DATABASE=melis-dev
MYSQL_USER=melis
MYSQL_PASSWORD=root

# React back-office (/melis-react) — ON by default, like install/prebuilt/fpm.
#
# ⚠ READ THIS ONCE, then it's the same as any other stack. Those stacks provision
# their own Melis; here the app dir is a bind mount of YOUR existing project
# (../../../), so the first boot rewrites your composer.json, composer.lock and
# config/application.config.php ON THE HOST — it composer-requires the `melis-react`
# branches (melis-core + MelisReactApi + MelisReactOverride) and patches
# application.config.php. COMMIT YOUR PROJECT FIRST so you can diff/revert it.
# Set this to 0 for a plain legacy Melis, leaving your project untouched.
# Idempotent — later boots detect it's already enabled and skip. No GitHub token needed.
WITH_REACT=1

# Melis skeleton version for `composer create-project`. Empty = latest stable.
# TEMPORARY DEFAULT — `dev-test/removed-forks` is the skeleton branch that drops the
# four laminas `vcs` repositories in favour of the Packagist-published
# melisplatform/laminas-* forks. That is what removes the GitHub API enumeration
# entirely, so no GitHub token is needed. Set back to empty once it is merged+released
# (note: the released skeleton still declares those vcs repos, so that path is slower).
SKELETON_VERSION=dev-test/removed-forks

# Host user the container's Apache runs as, so the app tree stays editable on your
# host. The entrypoint chowns the app dir to www-data (the web installer runs as
# Apache and rewrites composer.json / vendor/ / config/); these remap www-data to
# your uid/gid, so the same files are writable by Apache AND by you.
# Defaults suit a single-user Linux/WSL box. If `id -u` says something else, set it:
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
# Set HOST_UID=33 for the classic www-data ownership (tree not host-writable).
# Changing these needs a rebuild (`docker compose up -d --build`).
HOST_UID=1000
HOST_GID=1000

# NOTE — permissions: the container chowns your mounted project to www-data on boot,
# because the web installer (running as Apache) has to rewrite composer.json /
# composer.lock and install modules into vendor/. It cannot be done at build time:
# compose bind-mounts your project over the app dir at runtime, which masks any
# ownership baked into the image. Your melis-docker-react/ directory is skipped, so
# .env and the compose files stay yours. Thanks to HOST_UID/HOST_GID above, that
# chown lands on YOUR uid, so the files stay editable — no sudo chown needed.

# React dev server (Vite + HMR) — part of the stack, started by `docker compose up`
# like in install/. Only useful with WITH_REACT=1, and NOT needed to just USE
# /melis-react (PHP serves melis-core's committed production build). Its npm install
# lands in YOUR project at vendor/melisplatform/melis-core/ui-react/node_modules.
# Don't want it?  docker compose up -d php db   (or: docker compose stop vite)
VITE_PORT=5173
NODE_VERSION=22

