# Copy to .env and adjust:  cp .env.example .env

APP_NAME=melis-dev

MELIS_PLATFORM=dev
# NOTE: the setup wizard rewrites this line. On the last step ("Finish") it applies
# the site module name entered at the modules step as MELIS_MODULE — here (so it
# survives a down/up) and in the running container (so the front site answers right
# away, no restart). See conf/melis-module-applier.sh.
MELIS_MODULE=MySiteTest
TZ=Europe/Paris

# PHP version of the built image. 8.3 = default/recommended (officially supported).
# 8.4 = experimental but runs Melis. 8.5 needs extra fixes (see CLAUDE.md).
# Change → rebuild (docker compose up --build).
PHP_VERSION=8.3

MELIS_CONTAINER_NAME=melis-dev
# Host ports. Every runnable stack in this repo defaults to the SAME pair (8080 /
# 33061) because they are alternatives — you normally run one at a time. To run two
# side by side, change these here (and keep MELIS_CONTAINER_NAME distinct, which it
# already is for this stack), or put both behind the shared proxy (../../local-proxy).
HOST_PORT=8080
# Host-side port for the database. The container side is always 3306 and is not
# configurable — set this to any free port on your machine, NOT to 3306's twin.
DB_HOST_PORT=33061
MYSQL_VERSION=8.4
MYSQL_HOST=db
MYSQL_DATABASE=melis-dev
MYSQL_USER=melis
MYSQL_PASSWORD=root

# React back-office (/melis-react) — ON by default, like install/prebuilt/fpm.
#
# ⚠ READ THIS ONCE, then it's the same as any other stack. Those stacks provision
# their own Melis; here the app dir is a bind mount of YOUR existing project
# (../../../), so the first boot rewrites your composer.json, composer.lock and
# config/application.config.php ON THE HOST — it composer-requires the `melis-react`
# branches (melis-core + MelisReactApi + MelisReactOverride) and patches
# application.config.php. COMMIT YOUR PROJECT FIRST so you can diff/revert it.
# Set this to 0 for a plain legacy Melis, leaving your project untouched.
# Idempotent — later boots detect it's already enabled and skip. No GitHub token needed.
WITH_REACT=1

# Where an UN-INSTALLED platform sends every request (melis-installer's pre-install
# redirect guard). Empty/unset = the module's own default, /melis-react/setup — the
# React install wizard, served by MelisReactOverride's SPA route. Set it to
# /melis/setup to get the legacy wizard back. Only affects the pre-install redirect;
# both wizards stay reachable by URL either way, and the value is irrelevant once
# the platform is installed (you are then sent to /melis/login).
# NOT honoured by any released melis-installer yet — the stable 6.0.x on Packagist
# hardcodes /melis/setup and ignores this var (so you get the legacy wizard whatever
# you set here). It needs patches/melis-installer-react-setup-redirect.patch, which
# is what the dev-melis-react branch this repo tests against carries.
MELIS_SETUP_ROUTE=

# Melis skeleton version for `composer create-project`. Empty = latest stable.
# The 6.x line dropped the four laminas `vcs` repositories in favour of the
# Packagist-published melisplatform/laminas-* forks, which is what removes the GitHub
# API enumeration entirely — so no GitHub token is needed. Empty = latest stable.
# Pin to 5.3.x only if you need the old line; that one still declares those vcs repos
# and is slower / rate-limit-prone without a token.
# The React back-office modules are declared in the skeleton's own
# config/application.config.php since v6.0.6.
SKELETON_VERSION=^6.0

# Host user the container's Apache runs as, so the app tree stays editable on your
# host. The entrypoint chowns the app dir to www-data (the web installer runs as
# Apache and rewrites composer.json / vendor/ / config/); these remap www-data to
# your uid/gid, so the same files are writable by Apache AND by you.
# Defaults suit a single-user Linux/WSL box. If `id -u` says something else, set it:
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
# Set HOST_UID=33 for the classic www-data ownership (tree not host-writable).
# Changing these needs a rebuild (`docker compose up -d --build`).
HOST_UID=1000
HOST_GID=1000

# NOTE — permissions: the container chowns your mounted project to www-data on boot,
# because the web installer (running as Apache) has to rewrite composer.json /
# composer.lock and install modules into vendor/. It cannot be done at build time:
# compose bind-mounts your project over the app dir at runtime, which masks any
# ownership baked into the image. Your melis-docker-react/ directory is skipped, so
# .env and the compose files stay yours. Thanks to HOST_UID/HOST_GID above, that
# chown lands on YOUR uid, so the files stay editable — no sudo chown needed.

# React dev server (Vite + HMR) — part of the stack, started by `docker compose up`
# like in install/. Only useful with WITH_REACT=1, and NOT needed to just USE
# /melis-react (PHP serves melis-core's committed production build). Its npm install
# lands in YOUR project at vendor/melisplatform/melis-core/ui-react/node_modules.
# Don't want it?  docker compose up -d php db   (or: docker compose stop vite)
VITE_PORT=5173
NODE_VERSION=22

# --- Outgoing mail --------------------------------------------------------
# PHP's mail() needs an MTA; the php:*-apache base has none, so any send (the
# email-2FA login code, password resets) fails with "Unable to send mail: Unknown
# error". The image ships msmtp providing /usr/sbin/sendmail and the entrypoint
# configures it from these (conf/mail-setup.sh).
#
# Defaults = the stack's `mail` service (mailpit): every message is CAPTURED, none
# is delivered, and you read them — 2FA codes included — at
# http://localhost:8025. Nothing ever leaves your machine.
#
# To send for real, point these at ANY SMTP relay — the setting is not Gmail-specific:
#   Gmail / Workspace : SMTP_HOST=smtp.gmail.com  PORT=587  TLS=on   USER=you@gmail.com
#                       PASSWORD=<App Password, not the account password>
#   Company / OVH     : SMTP_HOST=mail.example.com  PORT=587 TLS=on  (or PORT=465 TLS=smtps)
#   Mailgun/SendGrid  : SMTP_HOST=smtp.mailgun.org  PORT=587 TLS=on  USER=<api user> PASSWORD=<key>
#   MTA on your host  : SMTP_HOST=host.docker.internal  PORT=25  TLS=off  (no user)
# SMTP_TLS: on|starttls (587), smtps (465, implicit TLS), off (plaintext — dev/LAN only).
# SMTP_FORCE_FROM=off keeps Melis' own From: (only for a relay that allows any sender).
# Unset/empty = the stack's `mail` service (the default below is applied by compose).
# To disable mail entirely, remove the `mail` service and set SMTP_HOST to a dead host.
#SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=off
SMTP_FROM=melis@localhost
# Host port of the mailpit web UI (bound to 127.0.0.1).
MAILPIT_PORT=8025
