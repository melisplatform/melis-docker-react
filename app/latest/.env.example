# Copy to .env and adjust:  cp .env.example .env

APP_NAME=melis-dev

MELIS_PLATFORM=dev
MELIS_MODULE=MySiteTest
TZ=Europe/Paris

# PHP version of the built image. 8.3 = default/recommended (officially supported).
# 8.4 = experimental but runs Melis. 8.5 needs extra fixes (see CLAUDE.md).
# Change → rebuild (docker compose up --build).
PHP_VERSION=8.3

MELIS_CONTAINER_NAME=melis-dev
# Host ports. Every runnable stack in this repo defaults to the SAME pair (8080 /
# 33061) because they are alternatives — you normally run one at a time. To run two
# side by side, change these here (and keep MELIS_CONTAINER_NAME distinct, which it
# already is for this stack), or put both behind the shared proxy (../../local-proxy).
HOST_PORT=8080
# Host-side port for the database. The container side is always 3306 and is not
# configurable — set this to any free port on your machine, NOT to 3306's twin.
DB_HOST_PORT=33061
MYSQL_VERSION=8.4
MYSQL_HOST=db
MYSQL_DATABASE=melis-dev
MYSQL_USER=melis
MYSQL_PASSWORD=root

# React back-office (/melis-react) — OFF by default in THIS stack, unlike
# install/prebuilt/fpm. Those provision their own Melis; here the app dir is a bind
# mount of YOUR existing project (../../../), and enabling React rewrites its
# composer.json, composer.lock and config/application.config.php on the host.
# Commit your work first, then set this to 1 and restart the container: the first
# boot composer-requires the public `melis-react` branches (melis-core +
# MelisReactApi + MelisReactOverride) and patches application.config.php.
# Idempotent — later boots detect it's already enabled and skip. Set GITHUB_TOKEN too.
WITH_REACT=0

# React dev server (Vite + HMR), opt-in via docker-compose.vite.yml — only useful
# with WITH_REACT=1. Not needed to just USE /melis-react (PHP serves the committed
# production build).  docker compose -f docker-compose.yml -f docker-compose.vite.yml up -d
VITE_PORT=5173
NODE_VERSION=22

# Optional — only when running behind the shared local nginx-proxy
# (docker-compose.proxy.yml). Hostname this stack answers to; the host port is dropped.
# VIRTUAL_HOST=melis-app.local

# GitHub API token. REQUIRED if WITH_REACT=1, strongly recommended otherwise.
#
#  - With WITH_REACT=1 it is mandatory and needs the `repo` scope: two of the three
#    React repositories (melisplatform/melis-react-api and melis-react-override) are
#    PRIVATE. Without it Composer falls back to the git driver and dies with
#    "fatal: could not read Username for 'https://github.com'". (melis-core is public.)
#  - Even with WITH_REACT=0 a token is worth setting (classic, no scopes needed for
#    this case): the Melis skeleton pulls laminas-mail/mime/crypt/file from four
#    github "vcs" repositories, so every Composer resolution the web installer runs
#    queries the GitHub API. Unauthenticated that is 60 requests/hour per public IP;
#    once spent, the installer's `composer require` dies with "Could not authenticate
#    against github.com" and — because the installer ignores Composer's exit code —
#    silently installs none of the modules you ticked, leaving them activated but
#    absent, which 500s every URL. A token lifts the limit to 5000/hour.
GITHUB_TOKEN=
