# Copy to .env and adjust if needed:  cp .env.example .env

# Image (published pre-built image). Pin a tag for reproducibility, e.g.
#   melisplatform/melis-docker:php8.3   or   :latest
MELIS_IMAGE=melisplatform/melis-docker:latest

# Only if you BUILD locally (uncomment the build: block in docker-compose.yml):
# PHP version of the image. 8.3 = default | 8.4 = experimental (runs Melis).
# (8.5 not usable: Laminas deps cap at 8.4 → the build's create-project fails.)
# PHP_VERSION=8.3

# App
APP_NAME=melis
MELIS_CONTAINER_NAME=melis
MELIS_PLATFORM=local
MELIS_MODULE=MySite
TZ=Europe/Paris

# React back-office (/melis-react): baked into the image (build with
# --build-arg WITH_REACT=0 for a legacy-only image). At runtime this flag only
# gates the entrypoint's defensive re-enable (e.g. an app volume seeded from an
# older, React-less image).
WITH_REACT=1

# Ports (host side)
HOST_PORT=8080
DB_HOST_PORT=33061

# Vite dev server host port — only used with the docker-compose.vite.yml override
# (live React UI development with HMR; not needed to just USE /melis-react).
VITE_PORT=5173

# Optional — only when running behind the shared local nginx-proxy
# (docker-compose.proxy.yml). Hostname this stack answers to; HOST_PORT is dropped.
# VIRTUAL_HOST=melis-prebuilt.local

# Database (these are the credentials to enter in the Melis web installer)
MYSQL_VERSION=8.4
MYSQL_DATABASE=melis
MYSQL_USER=melis
MYSQL_PASSWORD=melis

# Optional but STRONGLY recommended — GitHub API token (classic, no scopes needed;
# it only reads public repos). The Melis skeleton pulls laminas-mail/mime/crypt/file
# from four github "vcs" repositories — and the React enablement adds three more
# (melis-core, melis-react-api, melis-react-override) — so every Composer resolution
# the web installer runs queries the GitHub API. Unauthenticated that is 60 requests/hour per public IP;
# once spent, the installer's `composer require` dies with
#   "Could not authenticate against github.com"
# and — because the installer ignores Composer's exit code — silently installs none of
# the modules you ticked, leaving them activated but absent. A token lifts the limit to
# 5000/hour and makes the module step reliable.
GITHUB_TOKEN=
